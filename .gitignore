# === Q-Paw .gitignore ===
# Only track source/config files, exclude runtime-generated content

# --- Runtime directories (created by setup) ---
python/
python-macos/
python-linux/
data/
logs/
models/
cache/

# --- Runtime-generated files ---
config/portable.env

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- Backup files ---
*.bak
*.bak.*

# --- Compiled binaries (distribute via GitHub Releases) ---
QPaw.exe
bin/uv.exe
bin/uvx.exe

# --- IDE ---
.vscode/
.idea/
