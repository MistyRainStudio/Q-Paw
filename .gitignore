# === Q-Paw .gitignore ===
# Only track Q-Paw project source/config files

# --- Runtime directories (created by setup) ---
python/
python-macos/
python-linux/
data/
logs/
models/
cache/

# --- Non-project directories ---
skills/
upload/
download/

# --- Runtime-generated files ---
config/portable.env
.env

# --- Installer build artifacts (keep QPaw.exe, uv.exe, uvx.exe in repo) ---
installer/QPaw.exe

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- Backup files ---
*.bak
*.bak.*

# --- Python cache ---
__pycache__/
*.pyc

# --- IDE ---
.vscode/
.idea/
