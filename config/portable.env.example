# Q-Paw 便携模式配置
# =====================
# 此文件由 setup 脚本自动生成
# 便携模式下所有路径均相对于U盘根目录
# ========================================

# --- 运行模式 ---
# 1 = 便携模式（数据保存在U盘）
# 0 = 本地安装模式（数据保存在系统默认位置）
QP_PORTABLE_MODE=1

# --- 路径配置 ---
# 以下路径在便携模式下由启动脚本自动设置
# 如需自定义，请修改为绝对路径
# QP_DATA_DIR=./data
# QP_CONFIG_DIR=./config
# QP_MODELS_DIR=./models
# QP_LOG_DIR=./logs

# --- 模型运行模式 ---
# online = 在线模式（需要网络，调用云端API）
# local  = 离线模式（使用本地模型，无需网络）
QP_MODEL_MODE=online

# --- 默认模型设置 ---
# 当 QP_MODEL_MODE=local 时生效
# QP_DEFAULT_MODEL=QwenPaw-Flash-2B

# --- API 配置 ---
# 使用在线模式时，可配置以下API密钥
# 支持的提供商: dashscope, openai, openrouter
# QP_API_PROVIDER=dashscope
# QP_API_KEY=your-api-key-here

# --- 安全设置 ---
# 工具守卫：拦截危险命令执行
QP_TOOL_GUARD=1
# 文件防护：限制文件访问范围
QP_FILE_GUARD=1
# 技能扫描：安装前安全检查
QP_SKILL_SCAN=1

# --- 性能设置 ---
# 本地模型推理后端：auto / llama.cpp / ollama
# QP_INFERENCE_BACKEND=auto
# GPU 加速：0=仅CPU, 1=自动检测
# QP_GPU_ACCEL=1

# --- 包管理器 ---
# uv = 使用 uv（默认，比 pip 快 10-100 倍）
# pip = 使用 pip（兼容模式）
# QP_PKG_MGR=uv

# --- pip 镜像 ---
# 国内镜像加速，默认阿里云
# QP_PIP_MIRROR=https://mirrors.aliyun.com/pypi/simple/

# --- 日志级别 ---
# debug / info / warning / error
# QP_LOG_LEVEL=info
